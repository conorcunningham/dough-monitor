# Renews the Dough Monitor TLS certificate. `lego run` only renews when fewer than --renew-days
# remain, so it is safe to run daily (see lego-renew.timer). Installed by deploy/install-tls.sh,
# which fills in __HOST__ and __EMAIL__.
# The Domeneshop API credentials are read from /etc/caddy/domeneshop.env (root only).
# Zone lookups go through stubby (DNS-over-TLS on 127.0.0.1) so lego sees the public view of
# the domain; propagation checks are replaced by a fixed wait because the authoritative servers
# are only reachable on port 53, which the LAN resolver intercepts.
[Unit]
Description=Dough Monitor TLS certificate renewal (lego)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lego run \
    --path /var/lib/lego --env-file /etc/caddy/domeneshop.env \
    --email __EMAIL__ --accept-tos \
    --domains __HOST__ \
    --dns domeneshop --dns.resolvers 127.0.0.1:53 --dns.propagation.wait 90s \
    --renew-days 30 \
    --deploy-hook /usr/local/lib/dough-monitor/lego-deploy-hook.sh
