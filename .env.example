# Copy to .env and fill in. Values already set in the environment take precedence.

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# postgres://USER:PASSWORD@HOST:PORT/NAME
# The user needs CREATEDB so the parallel test runner can create its test databases.
DATABASE_URL=postgres://dough_monitor:change-me@localhost:5432/dough_monitor
DJANGO_LOG_LEVEL=INFO

# MQTT broker on the Raspberry Pi
MQTT_HOST=raspberrypi.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Keep this fixed: the broker queues readings for this client ID while the listener is offline.
# It must be unique per listener: two listeners sharing an ID (say a laptop and the Pi 5) keep
# kicking each other off the broker.
MQTT_CLIENT_ID=dough-monitor
MQTT_TOPICS=dough-monitor/#,rtl_433/+/events
