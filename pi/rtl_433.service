# systemd unit for rtl_433: decodes the 433 MHz sensor and publishes to MQTT.
#   sudo install -D -m 644 pi/rtl_433.conf /etc/rtl_433/rtl_433.conf
#   sudo cp pi/rtl_433.service /etc/systemd/system/
#   sudo systemctl enable --now rtl_433
# Runs as a throwaway system user. librtlsdr's udev rules give the dongle to
# the plugdev group, so nothing here needs editing for your username or paths.
[Unit]
Description=Dough Monitor rtl_433 receiver
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
DynamicUser=yes
SupplementaryGroups=plugdev
ExecStart=/usr/bin/rtl_433 -c /etc/rtl_433/rtl_433.conf
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
